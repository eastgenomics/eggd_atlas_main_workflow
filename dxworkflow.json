{
  "name": "atlas_main_workflow_GRCh38_v1.0.0",
  "title": "atlas_main_workflow_GRCh38_v1.0.0",
  "summary": "Main workflow for atlas pipeline",
  "stages": [
    {
      "id": "stage-sentieon_tnbam",
      "executable": "app-sentieon-tnbam/5.1.0",
      "folder": "/sentieon_vcfs"
    },
    {
      "id": "stage-verifybamid",
      "executable": "app-eggd_verifybamid/2.3.0",
      "folder": "/verifybamid_v2.3.0"
    },
    {
      "id": "stage-picard",
      "executable": "app-eggd_picard_QC/1.4.0",
      "folder": "/eggd_picardqc_v1.4.0",
      "input": {
        "vcf": {
          "$dnanexus_link": {
            "stage": "stage-sentieon_tnbam",
            "outputField": "variants_vcf"
          }
        },
        "vcf_index": {
          "$dnanexus_link": {
            "stage": "stage-sentieon_tnbam",
            "outputField": "variants_vcftbi"
          }
        }
      }
    },
    {
      "id": "stage-flagstat",
      "executable": "app-eggd_samtools_flagstat/1.1.0",
      "folder": "/samtools_flagstat_v1.1.0"
    },
    {
      "id": "stage-mosdepth",
      "executable": "app-eggd_mosdepth/1.2.0",
      "folder": "/eggd_mosdepth_v1.2.0"
    },
    {
      "id": "stage-athena",
      "executable": "app-eggd_athena/1.6.2",
      "folder": "/eggd_athena_v1.6.2",
      "input": {
        "mosdepth_files": [
          {
            "$dnanexus_link": {
              "stage": "stage-mosdepth",
              "outputField": "mosdepth_output"
            }
          }
        ]
      }
    },
    {
      "id": "stage-sex_check",
      "executable": "app-eggd_sex_check/1.2.1",
      "folder": "/eggd_sex_check"
    },
    {
      "id": "stage-sompy",
      "executable": "app-eggd_sompy/1.0.5",
      "folder": "/eggd_sompy_v1.0.5",
      "input": {
        "query_vcf": {
          "$dnanexus_link": {
            "outputField": "variants_vcf",
            "stage": "stage-sentieon_tnbam"
          }
        }
      }
    },
    {
      "id": "stage-vcf_normaliser",
      "executable": "app-eggd_vcf_normaliser/1.0.0",
      "folder": "/eggd_vcf_normaliser",
      "input": {
        "input_vcf": {
          "$dnanexus_link": {
            "stage": "stage-sentieon_tnbam",
            "outputField": "variants_vcf"
          }
        }
      }
    },
    {
      "id": "stage-eggd_vep",
      "executable": "app-eggd_vep/1.3.0",
      "folder": "/eggd_vep",
      "input": {
        "vcf": {
          "$dnanexus_link": {
            "stage": "stage-vcf_normaliser",
            "outputField": "output_vcf"
          }
        }
      }
    }
  ]
}
